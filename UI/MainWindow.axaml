<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Book_Shelf.UI"
        xmlns:resources="using:Book_Shelf.Resources"
        xmlns:automation="using:Avalonia.Automation"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Book_Shelf.MainWindow"
        XYFocus.NavigationModes="Keyboard"
        x:DataType="vm:LibraryViewModel"
        Icon="/Assets/bookshelf.ico"
        Title="{x:Static resources:Strings.BookShelf}"
        MinWidth="900"
        MinHeight="600">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="LibraryBackgroundColor">#F5F2ED</Color>
                    <Color x:Key="LibrarySurfaceColor">#FFFFFF</Color>
                    <Color x:Key="LibraryBorderColor">#E3E0DA</Color>
                    <Color x:Key="LibraryTextColor">#263238</Color>
                    <Color x:Key="LibraryMutedTextColor">#756F66</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="LibraryBackgroundColor">#1E2528</Color>
                    <Color x:Key="LibrarySurfaceColor">#293337</Color>
                    <Color x:Key="LibraryBorderColor">#46545A</Color>
                    <Color x:Key="LibraryTextColor">#F1F5F6</Color>
                    <Color x:Key="LibraryMutedTextColor">#B7C2C6</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Border.book-card">
            <Setter Property="Background" Value="{DynamicResource LibrarySurfaceColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LibraryBorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.book-card:focus">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
            <Setter Property="BoxShadow" Value="0 8 20 0 #28000000" />
        </Style>
        <Style Selector="Border.book-card[Tag=true]">
            <Setter Property="BorderBrush" Value="#E2A93B" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BoxShadow" Value="0 0 18 3 #55E2A93B" />
        </Style>
        <Style Selector="Border.cover">
            <Setter Property="Background" Value="#284B63" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource LibraryMutedTextColor}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Styles>

    <Grid Background="{DynamicResource LibraryBackgroundColor}">
        <Border x:Name="SplashScreen" Background="{DynamicResource LibraryBackgroundColor}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="20">
                <Image Source="/Assets/bookshelf.png"
                       Width="64"
                       Height="64"
                       Stretch="Uniform" />
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Static resources:Strings.BookShelf}"
                               HorizontalAlignment="Center"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource LibraryTextColor}" />
                    <TextBlock Text="{x:Static resources:Strings.LoadingLibrary}"
                               HorizontalAlignment="Center"
                               Classes="label" />
                </StackPanel>
                <ProgressBar Width="240"
                             Height="4"
                             IsIndeterminate="True" />
            </StackPanel>
        </Border>

    <DockPanel x:Name="LibraryContent"
               IsVisible="False"
               Background="{DynamicResource LibraryBackgroundColor}">
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource LibrarySurfaceColor}"
              automation:AutomationProperties.LandmarkType="Navigation">
            <MenuItem Header="{x:Static resources:Strings.Library}">
                <MenuItem Header="{x:Static resources:Strings.ChooseLibraryFolder}" Click="ChooseFolder_OnClick" />
                <MenuItem Header="{x:Static resources:Strings.RescanLibrary}" Click="Rescan_OnClick" />
                <Separator />
                <MenuItem Header="{x:Static resources:Strings.ImportDatabase}" Click="ImportDatabase_OnClick" />
                <MenuItem Header="{x:Static resources:Strings.ExportDatabase}" Click="ExportDatabase_OnClick" />
                <MenuItem Header="{x:Static resources:Strings.CleanDatabase}" Click="CleanDatabase_OnClick" />
                <Separator />
                <MenuItem Header="{x:Static resources:Strings.Exit}" Click="Exit_OnClick" />
            </MenuItem>
            <MenuItem Header="{x:Static resources:Strings.Configuration}" Click="Configuration_OnClick" />
            <MenuItem Header="{x:Static resources:Strings.Help}">
                <MenuItem Header="{x:Static resources:Strings.ViewErrorLogs}" Click="ViewErrorLogs_OnClick" />
                <MenuItem Header="{x:Static resources:Strings.AboutBookShelf}" Click="About_OnClick" />
            </MenuItem>
        </Menu>

          <Grid RowDefinitions="Auto,*"
              Margin="28,24,28,0"
              automation:AutomationProperties.LandmarkType="Main">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Static resources:Strings.YourLibrary}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource LibraryTextColor}" />
                    <TextBlock Text="{Binding LibraryFolder}" Classes="label" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            automation:AutomationProperties.LandmarkType="Search">
                    <TextBox Width="260"
                             TabIndex="1"
                             automation:AutomationProperties.Name="{x:Static resources:Strings.SearchTitleAuthorOrIsbn}"
                             PlaceholderText="{x:Static resources:Strings.SearchTitleAuthorOrIsbn}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Width="145"
                              TabIndex="2"
                              automation:AutomationProperties.Name="{x:Static resources:Strings.OrderBy}"
                              ItemsSource="{Binding OrderOptions}"
                              SelectedItem="{Binding SelectedOrder}"
                              PlaceholderText="{x:Static resources:Strings.OrderBy}" />
                    <ComboBox Width="125"
                              TabIndex="3"
                              automation:AutomationProperties.Name="{x:Static resources:Strings.Filter}"
                              ItemsSource="{Binding FilterOptions}"
                              SelectedItem="{Binding SelectedFilter}"
                              PlaceholderText="{x:Static resources:Strings.Filter}" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                               Classes="label"
                               Margin="0,0,0,16"
                               automation:AutomationProperties.LiveSetting="Polite" />
                    <ItemsControl ItemsSource="{Binding Books}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BookItemViewModel">
                                <Border Classes="book-card"
                                        Width="260"
                                        Tag="{Binding IsSelected}"
                                    automation:AutomationProperties.Name="{Binding Title}"
                                    automation:AutomationProperties.HelpText="{Binding Author}"
                                    automation:AutomationProperties.ControlTypeOverride="Button"
                                        PointerPressed="BookCard_PointerPressed"
                                        GotFocus="BookCard_GotFocus"
                                        KeyDown="BookCard_KeyDown"
                                        DoubleTapped="BookCard_DoubleTapped">
                                    <StackPanel Spacing="10">
                                        <Border Classes="cover" Height="320">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18" Spacing="10">
                                                    <TextBlock Text="{x:Static resources:Strings.Book}" Foreground="#DCE7EC" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" MaxHeight="100" />
                                                    <TextBlock Text="{Binding Author}" Foreground="#DCE7EC" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                                                </StackPanel>
                                                      <Image Source="{Binding CoverImage}"
                                                          Stretch="UniformToFill"
                                                          automation:AutomationProperties.AccessibilityView="Raw" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource LibraryTextColor}" TextWrapping="Wrap" MaxHeight="48" />
                                        <TextBlock Text="{Binding Author}" Classes="label" TextWrapping="Wrap" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Format}" Classes="label" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PageCount, StringFormat={x:Static resources:Strings.PageCountFormat}}"
                                                       Classes="label"
                                                       IsVisible="{Binding HasPageCount}" />
                                        </Grid>
                                        
                                        <Button Content="{x:Static resources:Strings.EditDetails}"
                                            automation:AutomationProperties.HelpText="{Binding Title}"
                                            Click="EditBook_OnClick"
                                            HorizontalAlignment="Left" />
                                        <Button Content="{x:Static resources:Strings.Delete}"
                                            automation:AutomationProperties.HelpText="{Binding Title}"
                                            Click="DeleteBook_OnClick" />
                                        
                                        <StackPanel IsVisible="{Binding IsEditing}" Spacing="6">
                                            <TextBox automation:AutomationProperties.Name="{x:Static resources:Strings.Title}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Static resources:Strings.Title}" />
                                            <TextBox automation:AutomationProperties.Name="{x:Static resources:Strings.Author}" Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Static resources:Strings.Author}" />
                                            <TextBox automation:AutomationProperties.Name="{x:Static resources:Strings.Isbn}" Text="{Binding Isbn, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Static resources:Strings.Isbn}" />
                                            <TextBox automation:AutomationProperties.Name="{x:Static resources:Strings.Pages}" Text="{Binding PageCount, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Static resources:Strings.Pages}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="{x:Static resources:Strings.Save}" Click="SaveBook_OnClick" />

                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
    </Grid>
</Window>